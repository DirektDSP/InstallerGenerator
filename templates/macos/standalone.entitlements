<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Standalone .app only.

  Under the hardened runtime (which notarization requires) a process gets no
  microphone access unless it asks for it. The JUCE standalone wrapper opens an
  input device on launch, so without this it starts up deaf. Plug-in formats
  never need it: the host owns the audio device and carries its own entitlement.

  Keep this minimal. Every entitlement added here is a permission the product
  asks users for, and Apple scrutinises the broad ones during notarization.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
